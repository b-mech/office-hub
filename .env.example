# Copy this file to .env and fill in your values.
# Never commit .env to the repository.

# Database
POSTGRES_USER=your-postgres-user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=your-postgres-database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname

# AI / Claude
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
ACTIVE_MODEL_PROVIDER=claude

# Storage (MinIO)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=documents
MINIO_URL=http://localhost:9000
MINIO_ROOT_USER=your-minio-root-user
MINIO_ROOT_PASSWORD=your-minio-root-password

# Email watcher
IMAP_HOST=imap.yourprovider.com
IMAP_USER=docs@yourcompany.com
IMAP_PASSWORD=your-imap-password
IMAP_FOLDER=INBOX

# App
ENVIRONMENT=development
APP_VERSION=0.1.0
DEFAULT_ORG_ID=uuid-of-default-org
DEFAULT_USER_ID=uuid-of-system-user
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://mail.google.com
CORS_ORIGIN_REGEX='(chrome-extension://.*|http://192\.168\.\d+\.\d+:3000)'
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth
SECRET_KEY=generate-a-secure-random-key
OFFICE_HUB_API_KEY=generate-a-secure-random-key
NEXT_PUBLIC_OFFICE_HUB_API_KEY=generate-a-secure-random-key
