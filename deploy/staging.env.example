# Overlay these values on a copy of the normal Office Hub environment.
ENVIRONMENT=staging
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@127.0.0.1:5432/officehub_staging
DATABASE_NULL_POOL=false
REDIS_URL=redis://127.0.0.1:6379/1
MINIO_BUCKET=officehub-staging
MINIO_ROOT_USER=officehub-staging
MINIO_ROOT_PASSWORD=SET_A_BUCKET_SCOPED_SECRET

PUBLIC_SITE_URL=https://officehub-staging.n10z.ca
PUBLIC_BASE_URL=https://officehub-staging.n10z.ca
NEXT_PUBLIC_API_URL=https://officehub-staging.n10z.ca/backend-api
BACKEND_INTERNAL_URL=http://127.0.0.1:8001
CORS_ORIGINS=https://officehub-staging.n10z.ca
GOOGLE_AUTH_REDIRECT_URI=https://officehub-staging.n10z.ca/api/auth/callback
FRONTEND_AUTH_CALLBACK_URL=https://officehub-staging.n10z.ca/auth/callback
AUTH_COOKIE_SECURE=true

# Staging outbound safety. An empty SMS allowlist blocks every recipient.
STAGING_SMS_ALLOWLIST=
STAGING_SLACK_CHANNEL_ID=
RINGCENTRAL_WEBHOOK_VALIDATION_TOKEN=SET_A_STAGING_ONLY_RANDOM_SECRET

# Explicit staging test keys; replace them if interactive testing calls for it.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
