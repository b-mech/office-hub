[Unit]
Description=Office Hub staging Celery beat scheduler
After=officehub-staging-worker.service
Requires=officehub-staging-worker.service

[Service]
Type=simple
WorkingDirectory=/home/officehub/office-hub-maint/backend
EnvironmentFile=/home/officehub/office-hub-maint/.env.staging
RuntimeDirectory=officehub-staging-beat
StateDirectory=officehub-staging
ExecStart=/home/officehub/office-hub-maint/backend/.venv/bin/celery -A app.workers.celery_app:celery_app beat --loglevel=INFO --pidfile=%t/officehub-staging-beat/celerybeat.pid --schedule=%S/officehub-staging/celerybeat-schedule
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
