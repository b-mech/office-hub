[Unit]
Description=Office Hub PRIVI Slack Socket Mode worker
After=network.target officehub-backend.service
Requires=officehub-backend.service

[Service]
Type=simple
User=officehub
WorkingDirectory=/home/officehub/office-hub/backend
EnvironmentFile=/home/officehub/office-hub/.env
ExecStart=/home/officehub/office-hub/backend/.venv/bin/python -m app.workers.slack
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
